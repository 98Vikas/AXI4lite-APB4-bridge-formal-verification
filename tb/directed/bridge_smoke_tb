
`timescale 1ns/1ps

module bridge_smoke_tb;

    localparam int ADDR_WIDTH = 32;
    localparam int DATA_WIDTH = 32;
    localparam int STRB_WIDTH = DATA_WIDTH / 8;

    logic aclk;
    logic aresetn;

    logic [ADDR_WIDTH-1:0] s_awaddr;
    logic [2:0] s_awprot;
    logic s_awvalid;
    logic s_awready;

    logic [DATA_WIDTH-1:0] s_wdata;
    logic [STRB_WIDTH-1:0] s_wstrb;
    logic s_wvalid;
    logic s_wready;

    logic [1:0] s_bresp;
    logic s_bvalid;
    logic s_bready;

    logic [ADDR_WIDTH-1:0] s_araddr;
    logic [2:0] s_arprot;
    logic s_arvalid;
    logic s_arready;

    logic [DATA_WIDTH-1:0] s_rdata;
    logic [1:0] s_rresp;
    logic s_rvalid;
    logic s_rready;

    logic [ADDR_WIDTH-1:0] paddr;
    logic [2:0] pprot;
    logic psel;
    logic penable;
    logic pwrite;
    logic [DATA_WIDTH-1:0] pwdata;
    logic [STRB_WIDTH-1:0] pstrb;
    logic pready;
    logic [DATA_WIDTH-1:0] prdata;
    logic pslverr;

    axi4lite_apb4_bridge dut (.*);

    always #5 aclk = ~aclk;

    initial begin
        aclk = 1'b0;
        aresetn = 1'b0;

        s_awaddr = '0;
        s_awprot = '0;
        s_awvalid = 1'b0;
        s_wdata = '0;
        s_wstrb = '0;
        s_wvalid = 1'b0;
        s_bready = 1'b1;
        s_araddr = '0;
        s_arprot = '0;
        s_arvalid = 1'b0;
        s_rready = 1'b1;

        pready = 1'b0;
        prdata = '0;
        pslverr = 1'b0;

        repeat (2) @(posedge aclk);
        aresetn <= 1'b1;

        // AXI-Lite write: address first.
        @(posedge aclk);
        s_awaddr  <= 32'h0000_0100;
        s_awprot  <= 3'b000;
        s_awvalid <= 1'b1;

        @(posedge aclk);
        if (s_awready)
            s_awvalid <= 1'b0;

        // Write data follows later.
        @(posedge aclk);
        s_wdata  <= 32'h1234_5678;
        s_wstrb  <= 4'hF;
        s_wvalid <= 1'b1;

        @(posedge aclk);
        if (s_wready)
            s_wvalid <= 1'b0;

        // APB completes after one wait cycle.
        wait (psel && penable);
        @(posedge aclk);
        pready <= 1'b1;

        @(posedge aclk);
        pready <= 1'b0;

        wait (s_bvalid);
        @(posedge aclk);

        // AXI-Lite read.
        s_araddr  <= 32'h0000_0200;
        s_arprot  <= 3'b000;
        s_arvalid <= 1'b1;

        @(posedge aclk);
        if (s_arready)
            s_arvalid <= 1'b0;

        wait (psel && penable);
        prdata <= 32'hA5A5_5A5A;
        @(posedge aclk);
        pready <= 1'b1;

        @(posedge aclk);
        pready <= 1'b0;

        wait (s_rvalid);
        if (s_rdata !== 32'hA5A5_5A5A)
            $error("Read data mismatch: %h", s_rdata);

        @(posedge aclk);
        $display("AXI4-Lite to APB4 smoke test completed.");
        $finish;
    end

endmodule
